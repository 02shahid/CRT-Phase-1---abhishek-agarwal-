// Problem 1-- Constructor overloading

#include <iostream>
using namespace std;

class rectangle {
    public:
    int length;
    int width;
    
    rectangle() {
     length = 1;
     width = 1;
        
    }
    rectangle(int side) {
        length = side;
        width = side;
    }
    rectangle(int side1, int side2) {
        length = side1;
        width = side2;
    }
    void showArea() {
        cout << length * width << "\n";
    }
};

int main() {
    rectangle r1;
    rectangle r2(5);
    rectangle r3(3,6);
    
    r1.showArea();
    r2.showArea();
    r3.showArea();
}

