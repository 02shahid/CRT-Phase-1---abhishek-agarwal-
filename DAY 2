//problem 2 -- if else cond.
// if cond.
// to verify user age whether eligible or not 

#include <iostream>
using namespace std;

int main() { 
    int age; 
    cin >> age;
    
    if(age>= 18) {
        cout << "eligible to vote";
    } else {
        cout << "not eligible to vote";
    }
    return 0;
}



//problem 3 --  nested if else cond.
// if else cond.
// to verify user age whether eligible or not 

#include <iostream>
using namespace std;

int main() { 
    int age; 
    cin >> age;
    
    if(age>= 18) {
        if (age>=100) {
            cout<< " eligible to vote but we are super senior citizens";
        } else {
            cout << "eligible to vote";
        }
    } else {
        if (age<0) {
            cout<< " enter a valid age number ";
        } else {
            cout<< " not eligible to vote";
        }
    }
    return 0;
}



// problem 4 - ternary operator
// find the greater number among 2
#include <iostream>
using namespace std;

int main() {
    int a, b;
    int max_Number;
    cout<< "enter no. a:";
    cin>> a ;
    cout<< "enter no. b:";
    cin>> b ;
    //ternary operator
    max_Number = (a>b) ? a : b;
    
    
    cout<<"maximum no. is:" << max_Number;
    return 0;
    
}
