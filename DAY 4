// problem 4 - print A right angled triangle mirror image

#include <iostream>
using namespace std;
int main(){
int n;
cout << "ENTER THE NO. OF ROWS:";
cin >> n;

    //number of times to print the pattern
    for(int i=1; i<=n; i++){
        
        // no. of spaces logic
        
        for(int j = n-i ; j>=1; j--) {
            cout<< " ";
        }
        //this defines what to print in the pattern
        for(int k=1; k<=i; k++){
            cout<< "*";
        }
        cout<< "\n";
    }
    return 0;
}
